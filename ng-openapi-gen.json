{
  "$schema": "node_modules/ng-openapi-gen/ng-openapi-gen-schema.json",
  "input": "openapi/api-docs.json",
  "output": "src/app/api",
  "enumStyle": "alias",
  "services": true,
  "promises": false,
  "apiService": false,
  "removeStaleFiles": true,
  "customizedResponseType": {
    "/users/me": {
      "toUse": "json"
    },
    "/users/me/email": {
      "toUse": "json"
    },
    "/auth/login": {
      "toUse": "json"
    },
    "/search": {
      "toUse": "json"
    },
    "/hello": {
      "toUse": "json"
    }
  }
}
